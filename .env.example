PORT=8000

# development | production
NODE_ENV=development
BRAND_NAME="Core"

# Semicolon-separated origins allowed for credentialed cross-origin requests (web client only; native apps are unaffected).
CORS_ALLOWED_ORIGINS="http://localhost:3000;https://app.example.com"

# NEON_BRANCH: production
DATABASE_URL="postgresql://<user>:<password>@<endpoint_hostname>.neon.tech:<port>/<dbname>?sslmode=require&channel_binding=require"

# Local PostgreSQL for docker compose; the api container overrides DATABASE_URL above with these
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=core
POSTGRES_PORT=5432

# Generate with: pnpm exec auth secret
BETTER_AUTH_SECRET="<random-secret>"
BETTER_AUTH_URL="http://localhost:8000"

# Generate at https://resend.com/api-keys
RESEND_API_KEY="<resend-api-key>"
RESEND_FROM_EMAIL="Core <onboarding@resend.dev>"

GOOGLE_CLIENT_ID="<google-oauth-client-id>"
GOOGLE_CLIENT_SECRET="<google-oauth-client-secret>"
APPLE_CLIENT_ID="<apple-oauth-client-id>"
APPLE_CLIENT_SECRET="<apple-oauth-client-secret>"
